@if (MemsApiClient.ImageUrl(Slug, ImageId) is { } url)
{
    <img src="@url" alt="@($"{Name} logo")" class="rounded bg-white border" style="@Style" />
}
else
{
    <div class="rounded d-flex align-items-center justify-content-center fw-bold tenant-fill" style="@Style" aria-hidden="true">
        @(string.IsNullOrEmpty(Name) ? "?" : Name[..1])
    </div>
}

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = "";
    [Parameter] public Guid? ImageId { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 48;

    private string Style => $"width:{Size}px;height:{Size}px;object-fit:cover;flex-shrink:0;";
}
