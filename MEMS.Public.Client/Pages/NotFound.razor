@page "/not-found"
@page "/{*path:nonfile}"

@* Catch-all for unknown page URLs (lowest route precedence: tenant routes, /api/* and the static
   framework files all win). The host answers 200 with the app, and this page tells the visitor. *@
<PageTitle>Page not found - Municipal Elections</PageTitle>

<div class="container py-5" id="page-not-found">
    <h1 class="h3">Page not found</h1>
    <p class="text-secondary">Sorry, the page you are looking for does not exist.</p>
    <a class="btn btn-primary" href="">Browse municipalities</a>
</div>

@code {
    [Parameter] public string? Path { get; set; }
}
