@page "/users/{Id}/reset-password"
@attribute [Authorize(Roles = AppRoles.SuperAdmin)]
@inject AdminUserService Users

<PageTitle>Reset password - MEMS Admin</PageTitle>

@if (loading)
{
    <p class="text-secondary">Loading...</p>
}
else if (current is null)
{
    <NotFoundCard What="Administrator" BackUrl="users" />
}
else
{
    <h1 class="h3">Reset password for @current.UserName</h1>
    <PageMessage Text="@message" Success="@succeeded" />
    <EditForm EditContext="editContext" OnValidSubmit="SaveAsync" FormName="reset-password">
        <DataAnnotationsValidator />
        <ValidationSummary class="alert alert-danger" />
        <div class="card mb-4">
            <div class="card-body row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label" for="r-new">New password</label>
                    <InputText id="r-new" type="password" class="form-control" @bind-Value="model.NewPassword" autocomplete="new-password" />
                    <ValidationMessage For="() => model.NewPassword" class="text-danger" />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label" for="r-confirm">Confirm password</label>
                    <InputText id="r-confirm" type="password" class="form-control" @bind-Value="model.ConfirmPassword" autocomplete="new-password" />
                    <ValidationMessage For="() => model.ConfirmPassword" class="text-danger" />
                </div>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary" disabled="@saving">Reset password</button>
            <a class="btn btn-outline-secondary" href="users">Back to administrators</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private AdminUserDto? current;
    private ResetPasswordInput model = new();
    private EditContext editContext = default!;
    private FormErrors errors = default!;
    private string? message;
    private bool succeeded;
    private bool loading = true;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        current = (await Users.GetAsync(Id)).Value;
        editContext = new EditContext(model);
        errors = new FormErrors(editContext);
        loading = false;
    }

    private async Task SaveAsync()
    {
        saving = true;
        var result = await Users.ResetPasswordAsync(Id, model);
        saving = false;
        succeeded = result.Succeeded;
        if (result.Succeeded)
        {
            message = $"The password of {current!.UserName} was reset. Their open sessions are signed out.";
            model = new ResetPasswordInput();
            editContext = new EditContext(model);
            errors = new FormErrors(editContext);
            return;
        }
        message = errors.Apply(result);
    }
}
