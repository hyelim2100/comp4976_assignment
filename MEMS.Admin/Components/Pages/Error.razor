@page "/Error"
@attribute [AllowAnonymous]
@using System.Diagnostics

<PageTitle>Error - MEMS Admin</PageTitle>

@* Friendly message only: the exception itself is logged on the server (Aspire dashboard). *@
<h1 class="h3 text-danger">Something went wrong</h1>
<p>
    The request could not be completed. Please try again; if the problem continues, contact the system
    administrator and quote the reference below.
</p>
@if (!string.IsNullOrEmpty(RequestId))
{
    <p class="small text-secondary">Reference: <code>@RequestId</code></p>
}
<a class="btn btn-outline-primary" href="">Back to the dashboard</a>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
