@model CandidateFormViewModel
@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<h1 class="h3 mb-3">Edit Candidate</h1>

<div class="row">
    <div class="col-lg-9">
        <form asp-action="Edit" asp-route-id="@Model.CandidateId" method="post" enctype="multipart/form-data">
            <partial name="_Form" model="Model" />
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.CandidateId">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/image-validation.js" asp-append-version="true"></script>
    <script src="~/js/position-filter.js" asp-append-version="true"></script>
}
