@model Municipality
@{
    ViewData["Title"] = Model.Name;
    var isSuperAdmin = (bool)ViewData["IsSuperAdmin"]!;
}

<div class="d-flex flex-wrap gap-3 align-items-center mb-4">
    <img src="@(Images.GetUrl(Model.LogoFileName) ?? "/images/placeholder-logo.svg")" alt="@Model.Name logo" class="rounded border" width="96" height="96" />
    <div class="flex-grow-1">
        <h1 class="h3 mb-1">@Model.Name</h1>
        <div class="text-muted">@Model.Province · Election on @Model.ElectionDate.ToString("dddd, MMMM d, yyyy")</div>
    </div>
    <div class="text-nowrap">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.MunicipalityId">Edit</a>
        @if (isSuperAdmin)
        {
            <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.MunicipalityId">Delete</a>
        }
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Description))
{
    <p class="lead fs-6">@Model.Description</p>
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-2">
    <h2 class="h5 mb-0">Positions</h2>
    <a class="btn btn-sm btn-primary" asp-controller="Positions" asp-action="Create" asp-route-municipalityId="@Model.MunicipalityId">Add position</a>
</div>
<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr><th>Position</th><th class="text-end">Seats</th><th class="text-end">Candidates</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Positions.OrderBy(p => p.PositionId))
            {
                <tr>
                    <td><a asp-controller="Positions" asp-action="Details" asp-route-id="@p.PositionId">@p.Name</a></td>
                    <td class="text-end">@p.SeatsAvailable</td>
                    <td class="text-end"><a asp-controller="Candidates" asp-action="Index" asp-route-positionId="@p.PositionId">@p.Candidates.Count</a></td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-controller="Candidates" asp-action="Create" asp-route-positionId="@p.PositionId">Add candidate</a></td>
                </tr>
            }
            @if (Model.Positions.Count == 0)
            {
                <tr><td colspan="4" class="text-muted">No positions yet.</td></tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Index">Back to municipalities</a>
