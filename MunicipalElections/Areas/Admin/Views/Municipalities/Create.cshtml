@model MunicipalityFormViewModel
@{
    ViewData["Title"] = "Add Municipality";
}

<h1 class="h3 mb-3">Add Municipality</h1>
<p class="text-muted">An admin group named "&lt;Name&gt; Admin" is created automatically for the new municipality.</p>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <partial name="_Form" model="Model" />
            <button type="submit" class="btn btn-primary">Create</button>
            <a class="btn btn-link" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/image-validation.js" asp-append-version="true"></script>
}
