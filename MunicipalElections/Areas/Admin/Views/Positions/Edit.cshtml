@model Position
@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<h1 class="h3 mb-3">Edit Position</h1>

<div class="row">
    <div class="col-lg-6">
        <form asp-action="Edit" asp-route-id="@Model.PositionId" method="post">
            <partial name="_Form" model="Model" />
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.PositionId">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
