@model Position
@{
    ViewData["Title"] = $"{Model.Name} — {Model.Municipality!.Name}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">@Model.Name</h1>
        <div class="text-muted">
            <a asp-controller="Municipalities" asp-action="Details" asp-route-id="@Model.MunicipalityId">@Model.Municipality.Name</a>
            · @Model.SeatsAvailable seat(s) available
        </div>
    </div>
    <div class="text-nowrap">
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.PositionId">Edit</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.PositionId">Delete</a>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-4 mb-2">
    <h2 class="h5 mb-0">Candidates (@Model.Candidates.Count)</h2>
    <a class="btn btn-sm btn-primary" asp-controller="Candidates" asp-action="Create" asp-route-positionId="@Model.PositionId">Add candidate</a>
</div>
<ul class="list-group mb-3">
    @foreach (var c in Model.Candidates.OrderBy(c => c.Name))
    {
        <li class="list-group-item d-flex align-items-center gap-3">
            <img src="@(Images.GetUrl(c.PhotoFileName) ?? "/images/placeholder-photo.svg")" alt="" class="rounded-circle" width="40" height="40" />
            <a asp-controller="Candidates" asp-action="Details" asp-route-id="@c.CandidateId">@c.Name</a>
        </li>
    }
    @if (Model.Candidates.Count == 0)
    {
        <li class="list-group-item text-muted">No candidates yet.</li>
    }
</ul>

<a asp-action="Index" asp-route-municipalityId="@Model.MunicipalityId">Back to positions</a>
