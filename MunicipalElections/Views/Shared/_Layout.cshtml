@using MunicipalElections.Services
@inject VotingGuide Guide
@{
    var controller = ViewContext.RouteData.Values["controller"] as string;
    var area = ViewContext.RouteData.Values["area"] as string;
    string NavClass(string name) => "nav-link" + (area is null && controller == name ? " active" : "");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Municipal Elections</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MunicipalElections.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-brand mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M9 12l2 2 4-4" /><rect x="3" y="4" width="18" height="16" rx="2" />
                    </svg>
                    <span class="fw-semibold">Municipal Elections</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="mainNav" class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="@NavClass("Municipalities")" asp-area="" asp-controller="Municipalities" asp-action="Index">Municipalities</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("Candidates")" asp-area="" asp-controller="Candidates" asp-action="Index">Candidates</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("VotingGuide")" asp-area="" asp-controller="VotingGuide" asp-action="Index">
                                My Voting Guide
                                <span class="badge rounded-pill bg-light text-dark ms-1" aria-label="@Guide.Count selected candidates">@Guide.Count</span>
                            </a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="container flex-grow-1 pb-4">
        @RenderBody()
    </main>

    <footer class="border-top py-3 text-muted small bg-light">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; 2026 Municipal Elections Management System — BCIT COMP4976 student project. Sample data only; not an official election website.</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
