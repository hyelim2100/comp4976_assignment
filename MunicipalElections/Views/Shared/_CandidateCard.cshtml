@model Candidate
@{
    var position = Model.Position!;
    var showMunicipality = ViewData["ShowMunicipality"] as bool? ?? true;
}

<div class="col" id="candidate-@Model.CandidateId">
    <div class="card h-100 card-hover">
        <a asp-controller="Candidates" asp-action="Details" asp-route-id="@Model.CandidateId">
            <img src="@(Images.GetUrl(Model.PhotoFileName) ?? "/images/placeholder-photo.svg")" alt="Photograph of @Model.Name" class="card-img-top candidate-photo" loading="lazy" />
        </a>
        <div class="card-body d-flex flex-column">
            <h3 class="h6 card-title mb-1">
                <a class="text-decoration-none" asp-controller="Candidates" asp-action="Details" asp-route-id="@Model.CandidateId">@Model.Name</a>
            </h3>
            <div class="small text-muted mb-2">
                @position.Name@(showMunicipality ? $" · {position.Municipality!.Name}" : "")
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Profile))
            {
                <p class="small line-clamp-3 mb-3">@Model.Profile</p>
            }
            <div class="mt-auto d-flex flex-wrap gap-2">
                <a class="btn btn-sm btn-outline-primary" asp-controller="Candidates" asp-action="Details" asp-route-id="@Model.CandidateId">Profile</a>
                <partial name="_GuideButton" model="Model" />
            </div>
            <div class="form-check small mt-2 mb-0">
                <input class="form-check-input" type="checkbox" id="compare-@Model.CandidateId" data-compare-id="@Model.CandidateId" />
                <label class="form-check-label" for="compare-@Model.CandidateId">Compare</label>
            </div>
        </div>
    </div>
</div>
